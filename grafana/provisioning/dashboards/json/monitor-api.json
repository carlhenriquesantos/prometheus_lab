        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route, status_code) (rate(http_requests_errors_total[1m]))",
          "legendFormat": "{{route}} {{status_code}}"
        }
      ],
      "fieldConfig": {
